# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Pick the provider you'll run with (see README).

# Together AI (default; OpenAI-compatible). Run where api.together.xyz is reachable.
TOGETHER_API_KEY=

# OpenAI (alternative).
OPENAI_API_KEY=

# Anthropic / Claude (the only provider reachable from the Claude-on-the-web sandbox).
# Use with: --provider anthropic --retriever tfidf  (Anthropic has no embeddings API)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-4-5
