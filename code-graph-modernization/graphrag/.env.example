# Set the key for your provider, then: graphrag index --root . --skip-validation
#
# In the Claude-on-the-web sandbox, Anthropic is the only reachable LLM host, so
# this must be your ANTHROPIC API key (settings.yaml is set to model_provider: anthropic).
#
# For a LOCAL full run with embeddings, set this to your OpenAI/Together key and
# edit settings.yaml (model_provider + restore generate_text_embeddings in workflows).
GRAPHRAG_API_KEY=<your-api-key>
